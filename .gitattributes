# Keep repository text deterministic across Windows, Linux, and macOS.
* text=auto eol=lf

# Windows-native scripts and registry files require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.reg text eol=crlf
*.url text eol=crlf

# Preserve intentionally UTF-16LE files byte-for-byte.
"Executables/SystemRuntime/Other/Force Timer Resolution.xml" -text
Executables/SystemRuntime/Scripts/Registry/SecurityHealthTray/enable.reg -text
Executables/SystemRuntime/Scripts/Registry/TakeOwnership/add.reg -text
Executables/SystemRuntime/Scripts/Registry/TakeOwnership/remove.reg -text

# Cross-platform shell scripts remain LF.
*.sh text eol=lf

# Never normalize binary payloads.
*.apbx binary
*.cab binary
*.dll binary
*.exe binary
*.ico binary
*.lnk binary
*.png binary
*.zip binary
